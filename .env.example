# ==============================================================================
# .env.example — Vinyas Environment Configuration Template
# Copy to `.env` (`cp .env.example .env`) or run `bash scripts/provision_gcp.sh`
# Strictly NO hardcoded API keys or secrets.
# ==============================================================================

GEMINI_API_KEY="your-gemini-api-key"
GOOGLE_CLOUD_PROJECT="vinyas-buildathon-6626"
GCP_PROJECT_ID="vinyas-buildathon-6626"
GCP_LOCATION="asia-south1"
ALLOYDB_DSN=""
GCS_BUCKET="gs://vinyas-buildathon-6626-qa-vault"
DEMO_FALLBACK_ENABLED=true
SQLITE_FALLBACK_PATH="./vinyas_local.db"

# Edge Gateway Settings (/edge_client/edge_gateway.py)
OLLAMA_BASE_URL="http://localhost:11434"
EDGE_GEMMA_MODEL_ID="gemma4:e4b"
CLOUD_RUN_BACKEND_URL=""
